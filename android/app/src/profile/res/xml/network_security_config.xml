<?xml version="1.0" encoding="utf-8"?>
<!--
  Izin HTTP polos untuk Firebase Emulator Suite — **hanya di build debug
  dan profil.**

  Sejak Android 9 (API 28) lalu lintas HTTP polos diblokir diam-diam, dan
  emulator Firebase memang berbicara HTTP. Tanpa berkas ini panggilan
  `signInAnonymously()` menggantung tanpa satu pun pesan galat, yang
  membuatnya sangat lama tidak ketahuan.

  Dua alamat di bawah adalah host yang dilihat emulator Android sebagai
  komputer pengembang. Berkas ini tidak pernah ikut ke build rilis, jadi
  aplikasi yang dipasang anak tetap menolak seluruh HTTP polos.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
