# Salin berkas ini jadi `.env` di akar proyek.
#
# Nilai yang sama bisa diberikan lewat --dart-define saat build, dan
# --dart-define selalu menang atas .env.

# true = jalan sepenuhnya luring, tanpa Firebase sama sekali.
# Di Tahap 1 nilainya selalu true: tidak ada satu baris pun kode Firebase.
OFFLINE_ONLY=true

# baru diisi mulai Tahap 3
FIREBASE_PROJECT_ID=
ENABLE_LEADERBOARD=false
